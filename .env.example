# ─── Cold Email Engine ───
# Copy this file to .env.local then fill in your keys.
# Or rename to .env (loaded automatically by all scripts)

# ─── LLM Providers ───
# OpenAI — used for Step 4 (breakup emails) + fallback
OPENAI_API_KEY=sk-...

# DeepSeek — used for Step 1 (pattern interrupt) + Step 3 (objection handling)
DEEPSEEK_API_KEY=sk-...

# OpenRouter — used for Step 2 (social proof) + GPT-4o access
OPENROUTER_API_KEY=sk-or-...

# Anthropic — optional fallback
ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini — optional fallback
GEMINI_API_KEY=AIza...

# ─── Email Verification ───
# Reoon Email Verifier — validates emails before generation
REOON_API_KEY=

# ─── File Paths ───
# Input CSV file (LeadRocks / Outscraper export)
INPUT_CSV=data/leads.csv

# Output directory for generated CSV files (defaults to project root)
OUTPUT_DIR=.

# ReachInbox-ready CSV output path
REACHINBOX_OUTPUT=cold-email-reachinbox-PRODUCTION.csv

# ─── Batch Pipeline ───
# State directory for checkpoint/resume files (defaults to scripts/batch2-state/)
STATE_DIR=scripts/batch2-state

# Already-shipped batch CSV (to avoid double-messaging)
PREVIOUS_BATCH=cold-email-reachinbox-PRODUCTION.csv

# ─── Local Inference (optional) ───
# LM Studio / Ollama local endpoint
LOCAL_BASE_URL=http://localhost:1234/v1

# Local model name
LOCAL_MODEL=google/gemma-4-e4b

# ─── Web App ───
# Default provider for the web UI round-robin
NEXT_PUBLIC_DEFAULT_PROVIDER=openai
